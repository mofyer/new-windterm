{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-pty",
  "description": "Only the bundled main window may control its own PTY sessions and one-shot SSH verification.",
  "windows": ["main"],
  "permissions": ["core:default", "allow-pty-open", "allow-pty-write", "allow-pty-resize", "allow-pty-ack", "allow-pty-close", "allow-ssh-probe", "allow-ssh-accept", "allow-ssh-reject", "allow-ssh-cancel", "allow-ssh-context"]
}
