{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-pty",
  "description": "Only the bundled main window may control its own local PTY sessions.",
  "windows": ["main"],
  "permissions": ["core:default", "allow-pty-open", "allow-pty-write", "allow-pty-resize", "allow-pty-ack", "allow-pty-close"]
}
