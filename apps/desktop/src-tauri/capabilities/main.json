{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-pty",
  "description": "Only the bundled main window may control its own PTY, SSH, Telnet/raw TCP and read-only SFTP sessions.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-pty-open",
    "allow-pty-write",
    "allow-pty-resize",
    "allow-pty-ack",
    "allow-pty-close",
    "allow-ssh-probe",
    "allow-ssh-accept",
    "allow-ssh-reject",
    "allow-ssh-cancel",
    "allow-ssh-auth-respond",
    "allow-ssh-context",
    "allow-ssh-open",
    "allow-ssh-write",
    "allow-ssh-resize",
    "allow-ssh-ack",
    "allow-ssh-close",
    "allow-ssh-forward-add",
    "allow-ssh-forward-remove",
    "allow-ssh-forward-list",
    "allow-ssh-sftp-open",
    "allow-ssh-sftp-list",
    "allow-ssh-sftp-metadata",
    "allow-ssh-sftp-read",
    "allow-ssh-sftp-close",
    "allow-ssh-trust-save",
    "allow-ssh-trust-replace",
    "allow-net-open",
    "allow-net-write",
    "allow-net-resize",
    "allow-net-ack",
    "allow-net-close"
  ]
}
